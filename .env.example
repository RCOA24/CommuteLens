# Copy this file to .env.local and fill only the integrations you enable.
# Never commit .env.local or use NEXT_PUBLIC_ for a secret.

# Transit routing — server-side only. Provider order is BusMaps (when keyed),
# then the archival DOTC/Sakay open GTFS route-pattern fallback, then distance.
# Set TRANSIT_PROVIDER=demo for rehearsal, =gtfs to test open data only, or
# =busmaps to prefer BusMaps even when its key is missing.
TRANSIT_PROVIDER=
BUSMAPS_API_KEY=
OPEN_GTFS_ENABLED=true
# Optional ZIP override. Defaults to the public sakayph/gtfs repository archive.
OPEN_GTFS_URL=

# GTFS catalog discovery — optional. Static routing does not require this token.
MOBILITY_DATABASE_REFRESH_TOKEN=

# AI explanation — server-side only. The deterministic analysis must work without it.
# When this is empty the app returns the deterministic explanation instead.
OPENAI_API_KEY=
OPENAI_MODEL=
# Route research uses the stronger Responses/web-search model by default.
# Keep this timeout below the route-plan API maxDuration (90 seconds).
OPENAI_ROUTE_RESEARCH_MODEL=gpt-5.6
OPENAI_ROUTE_RESEARCH_TIMEOUT_MS=60000
OPENAI_ROUTE_RESEARCH_MAX_OUTPUT_TOKENS=3000

# Backboard.io — server-side only. Powers offer-letter document extraction and the
# commuter memory layer (profile + offer ledger). Both features are additive: when
# this key is absent the app keeps working and reports the degraded reason.
# Format: BACKBOARD_API_KEY=<key> — no quotes, no spaces around the "=".
BACKBOARD_API_KEY=
# Optional. Defaults to https://app.backboard.io/api
BACKBOARD_BASE_URL=
# Optional. Defaults to openai / gpt-4o-mini — cheap is correct here, because the
# model only transcribes fields out of a document and never computes a figure.
BACKBOARD_LLM_PROVIDER=
BACKBOARD_MODEL=
# Optional. Whole-request budget for one extraction, including document indexing.
BACKBOARD_TIMEOUT_MS=25000
# Optional. Set BACKBOARD_MEMORY=off to keep extraction but disable persistence.
BACKBOARD_MEMORY=

# PaddleOCR AI Studio — server-side only. Converts an uploaded PDF or photo into
# markdown text before the field reader sees it. Two reasons it is worth a hop:
# photos and scans are read far better than by a general model, and holding the
# source text lets the guardrails verify every extracted figure against it.
# Without this key, documents are sent to Backboard as attachments instead.
PADDLEOCR_API_KEY=
# Optional. PP-StructureV3 (default) or PaddleOCR-VL-1.6. Both return markdown
# text, which preserves the salary tables offer letters often use. The default is
# the faster of the two — a layout pipeline rather than a vision-language model
# doing a full pass per page. Switch to PaddleOCR-VL-1.6 when quality on creased,
# dim, or handwritten phone photos matters more than the seconds. PP-OCRv6 is
# not supported here: its job result exposes no text field.
PADDLEOCR_MODEL=
# Optional. Defaults to https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_JOB_URL=
# Optional. Whole-pipeline budget in ms for submit + poll + result download.
# Keep this below your Vercel function maxDuration. Defaults to 45000.
PADDLEOCR_TIMEOUT_MS=

# Geocoding — server-side only. Geoapify is selected automatically when its key is
# present and also serves the same-origin map-tile proxy, so the key never reaches
# the browser. Nominatim is the keyless fallback: respect its usage policy and keep
# provider access behind GeocodingProvider.
# Set GEOCODING_PROVIDER=demo to force the offline curated geocoder — use this
# for a rehearsal on an unreliable venue network. =geoapify or =nominatim pins one.
GEOCODING_PROVIDER=
NOMINATIM_ENDPOINT=
# Nominatim requires an identifying User-Agent. Identify the deployment, not the user.
NOMINATIM_USER_AGENT=

# Geoapify — server-side only. Used for two things: the Geoapify geocoder above,
# and the proxied map tiles. Without it the tile route returns 503 and the map
# shows its fallback notice; every route figure on the page is unaffected.
GEOAPIFY_API_KEY=

# PAGASA ten-day forecast — optional base-URL override. Defaults to the public endpoint.
PAGASA_TENDAY_API_URL=

# Signs the opaque fare-confirmation leg keys — server-side only.
# When empty, each process generates a random secret at startup, so keys stop
# matching across a restart or a second instance and reports no longer aggregate.
# Set this on any deployment running more than one instance.
FARE_CONFIRMATION_HMAC_SECRET=
