# Copy this file to .env.local and fill only the integrations you enable.
# Never commit .env.local or use NEXT_PUBLIC_ for a secret.

# Transit routing — server-side only. Provider order is BusMaps (when keyed),
# then the archival DOTC/Sakay open GTFS route-pattern fallback, then distance.
# Set TRANSIT_PROVIDER=demo for rehearsal, =gtfs to test open data only, or
# =busmaps to prefer BusMaps even when its key is missing.
TRANSIT_PROVIDER=
BUSMAPS_API_KEY=
OPEN_GTFS_ENABLED=true
# Optional ZIP override. Defaults to the public sakayph/gtfs repository archive.
OPEN_GTFS_URL=

# GTFS catalog discovery — optional. Static routing does not require this token.
MOBILITY_DATABASE_REFRESH_TOKEN=

# AI explanation — server-side only. The deterministic analysis must work without it.
# When this is empty the app returns the deterministic explanation instead.
OPENAI_API_KEY=
OPENAI_MODEL=

# Nominatim is the selected MVP geocoder and does not require an API key.
# Respect its usage policy and keep provider access behind GeocodingProvider.
# Set GEOCODING_PROVIDER=demo to force the offline curated geocoder — use this
# for a rehearsal on an unreliable venue network.
GEOCODING_PROVIDER=
NOMINATIM_ENDPOINT=
# Nominatim requires an identifying User-Agent. Identify the deployment, not the user.
NOMINATIM_USER_AGENT=
